# Caddy del host — TLS automático (Let's Encrypt) para Reservorio.
# Define FRONTEND_HOST en el entorno del servicio Caddy y apunta el DNS al servidor.

{$FRONTEND_HOST} {
	# Redirige www → apex si configuras ambos en FRONTEND_HOST="tu-dominio.com,www.tu-dominio.com"
	# handle @www { host www.{$FRONTEND_HOST} }
	# redir https://{$FRONTEND_HOST}{uri}

	# Headers de seguridad (complemento a los de Nginx local)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Nginx sirve el frontend y envía /api al backend local.
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}

	encode gzip
}
