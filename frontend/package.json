{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "format:check": "prettier --check \"../(frontend|backend|docs)/**/*.{ts,html,js,json,md,yml,yaml,scss,css}\"",
    "format:fix": "prettier --write \"../(frontend|backend|docs)/**/*.{ts,html,js,json,md,yml,yaml,scss,css}\"",
    "lint": "eslint \"frontend/**/*.{ts,tsx,js,jsx}\" --quiet",
    "coverage": "vitest run --coverage"
  },
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=9.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/localize": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/service-worker": "22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.14.2",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.27",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.2",
    "postcss": "^8.5.8",
    "prettier": "^3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
