{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"../(frontend|backend|docs)/**/*.{ts,html,js,json,md,yml,yaml,scss,css}\"",
    "format:fix": "prettier --ignore-path ../.prettierignore --write \"../(frontend|backend|docs)/**/*.{ts,html,js,json,md,yml,yaml,scss,css}\"",
    "lint": "eslint \"frontend/**/*.{ts,tsx,js,jsx}\" --quiet",
    "coverage": "vitest run --coverage"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=12.15.0 <13"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "firebase": "^13.1.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.2",
    "three": "^0.186.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.5.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
