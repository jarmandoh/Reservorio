# Production environment template for Docker Compose / host deployment
# Copy to .env.production and replace sensitive values before deploy

# App runtime
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgres://reservorio:change_me_db_password@db:5432/reservorio

# Auth
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
ADMIN_PIN=1234

# CORS
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Google / Sheets integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKENS_KEY=
SHEET_ID=
APPS_SCRIPT_URL=

# Frontend runtime config
API_URL=/api
