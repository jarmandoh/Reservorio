# ── Ejemplo de configuración de PRODUCCIÓN ────────────────────────────────────
# Copia este archivo a backend/.env y sustituye TODOS los valores.
# Genera los secretos con: node scripts/generate-secrets.mjs
#
# Validaciones en producción (el backend aborta si fallan):
#   - DATABASE_URL debe apuntar a PostgreSQL
#   - JWT_SECRET ≥ 32 caracteres
#   - ADMIN_PIN ≠ 1234 y ≥ 6 caracteres, o ADMIN_PIN_HASH (bcrypt) definido
#   - CORS_ORIGINS con al menos un origen permitido
#   - FRONTEND_URL debe ser una URL https:// válida

PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- P0: Escalabilidad ---

# Redis para rate-limit distribuido y caché (listBusinesses, ratings). Si se deja
# vacío, el backend usa fallback en memoria (sin distribución). En docker-compose
# el servicio redis ya está cableado: redis://redis:6379
REDIS_URL=redis://redis:6379

# Trust proxy: 1 tras nginx (default), 0 si expones backend directo
TRUST_PROXY=1

# Pool de Postgres (pg). Aumenta PG_POOL_MAX si subes réplicas del backend.
# PgBouncer en modo transaction también es compatible: deja estos valores y apunta
# DATABASE_URL al puerto de PgBouncer.
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=10000
PG_POOL_CONNECTION_TIMEOUT=5000
PG_STATEMENT_TIMEOUT=10000
PG_QUERY_TIMEOUT=10000

# TTL de caché para listados (segundos)
CACHE_TTL_SECONDS=60
CACHE_TTL_RATINGS_AVG=60
CACHE_TTL_RATINGS_LIST=30

# Límite global del rate limiter por IP en 15 min (defecto: 60). Solo súbelo
# si necesitas testear E2E contra el backend; en producción deja el defecto.
RATE_LIMIT_MAX=60

# Postgres alcanzable desde el contenedor backend
DATABASE_URL=postgres://reservorio:reservorio_pass@db:5432/reservorio

# URL pública del frontend (se usa en los magic-links, CORS y la no-reply)
FRONTEND_URL=https://tu-dominio.com

# Clave secreta para firmar JWT (genera una con: node scripts/generate-secrets.mjs)
JWT_SECRET=cambia_este_valor_por_una_clave_de_32_caracteres_o_mas

# PIN del panel de administración global (nunca "1234"). Recomendado: definir
# ADMIN_PIN_HASH (bcrypt, generado con scripts/generate-secrets.mjs) y dejar
# ADMIN_PIN vacío.
ADMIN_PIN=cambia_este_pin_a_uno_seguro
ADMIN_PIN_HASH=

# Orígenes CORS permitidos del frontend
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# OTP / magic-links
# OTP_DEBUG=1 expone los códigos one-time en las respuestas (SOLO para desarrollo).
OTP_DEBUG=0
OTP_MAX_REQUESTS=10
OTP_WINDOW_MIN=15
# Horas de ventana para reemitir tokens de sesión expirados (defecto: 6)
REFRESH_GRACE=6

# Worker de recordatorios (1 = activo). Envía email/SMS según sms_opt_in.
ENABLE_REMINDER_WORKER=1
REMINDER_WINDOW_HOURS=24
REMINDER_INTERVAL_MINUTES=60

# Notificaciones por email
EMAIL_PROVIDER=webhook
EMAIL_FROM=reservas@tu-dominio.com
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_HEADERS=Authorization: Bearer <token>

# Notificaciones por SMS
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_WEBHOOK_HEADERS=Authorization: Bearer <token>

# Google Sheets (opcional): hoja de sincronización
SHEET_ID=
APPS_SCRIPT_URL=

# Google OAuth (opcional): credenciales + cifrado de tokens (clave hex de 64 chars)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKENS_KEY=
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/google/callback

# Stripe (opcional): clave secreta y firma de webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transferencias (opcional): datos para el detalle de pago por transferencia
TRANSFER_BANK=
TRANSFER_IBAN=
TRANSFER_BENEFICIARY=