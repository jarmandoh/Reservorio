{
  "name": "reservorio-backend",
  "version": "1.0.0",
  "description": "Reservorio — Express API proxy para Google Sheets",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --watch src src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll",
    "test:integration": "jest --runInBand test/real-business.routes.test.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate:create": "node scripts/create-migration.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=9.15.0"
  },
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^173.0.0",
    "compression": "^1.8.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "pino": "^10.3.1",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.2.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "collectCoverage": false,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 45,
        "functions": 50,
        "lines": 55,
        "statements": 55
      }
    }
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
