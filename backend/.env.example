# Genera secretos con: node scripts/generate-secrets.mjs
# Luego copia la salida aquí y haz: chmod 600 backend/.env
# NUNCA commitees este archivo (ver .gitignore)
PORT=3000
DATABASE_URL=postgres://reservorio:reservorio_pass@localhost:5432/reservorio
JWT_SECRET=cambia_este_valor_por_una_clave_larga_y_segura  # 64 hex chars, ver generate-secrets.mjs
ADMIN_PIN=1234  # en producción usa ADMIN_PIN_HASH (bcrypt) y deja ADMIN_PIN vacío
TRUST_PROXY=1
REDIS_URL=redis://localhost:6379  # vacío = fallback memoria (sin distribución)
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=10000
PG_STATEMENT_TIMEOUT=10000
CACHE_TTL_SECONDS=60
JSON_LIMIT=100kb
# Hash bcrypt del PIN de admin (alternativa segura a ADMIN_PIN; si se define, se usa
# para comparar y ADMIN_PIN se ignora en la autenticación).
ADMIN_PIN_HASH=
# Renovación de sesiones: ventana (en horas) en la que un token expirado puede
# reemitirse vía POST /api/auth/refresh para no cortar sesiones activas.
REFRESH_GRACE=6
# Worker de recordatorios: activa el cron interno que avisa a los clientes 24h antes
# de su reserva (email y, si aplica, SMS con sms_opt_in). 1 = activo.
ENABLE_REMINDER_WORKER=1
# Ventana (horas) antes de la reserva en la que se dispara el recordatorio.
REMINDER_WINDOW_HOURS=24
# Anti-spam en OTP/magic-link: máximo de solicitudes por email en la ventana indicada.
# Tras superarlo se responde genérico (sin enumerar) durante el resto de la ventana.
OTP_MAX_REQUESTS=5
OTP_WINDOW_MIN=60
# Nivel de log del logger estructurado (pino): trace|debug|info|warn|error
LOG_LEVEL=info
SHEET_ID=1cxZR6YYFkXJy8AKGM-1AakGk9hw6AR9vTv2RHm4yUNc
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKENS_KEY=
CORS_ORIGINS=http://localhost:4200,http://localhost:80
NODE_ENV=development

# ── Canales de notificación (email / SMS) ────────────────────────────────────
# Proveedor: 'console' (por defecto — registra en log/outbox) o 'http' (POST JSON
# a los webhooks indicados, compatible con Resend, SendGrid, Brevo, Twilio, etc.)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@reservorio.app
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_HEADERS={"Authorization":"Bearer TU_API_KEY"}
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_HEADERS={"Authorization":"Bearer TU_API_KEY"}
# URL pública del frontend — usada en el magic-link y en los enlaces de historial
FRONTEND_URL=http://localhost:4200
# Depuración: expone el código/token en la respuesta del endpoint (SOLO dev/test)
OTP_DEBUG=1
