{
  "name": "reservorio-workspace",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=12.15.0 <13"
  },
  "scripts": {
    "build": "turbo run build",
